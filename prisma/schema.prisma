generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Core Multi-Tenant
// ------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  businessType String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  country      String   @default("India")
  postalCode   String?
  logoUrl      String?
  timezone     String   @default("Asia/Kolkata")
  currency     String   @default("INR")
  taxNumber    String?
  status       TenantStatus @default(ACTIVE)
  trialEndDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  planId       String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptions TenantSubscription[]

  settings          TenantSettings?
  users             User[]
  staff             Staff[]
  customers         Customer[]
  serviceCategories ServiceCategory[]
  services          Service[]
  appointments      Appointment[]
  invoices          Invoice[]
  payments          Payment[]
  offers            Offer[]
  offerServices     OfferService[]
  whatsAppLogs      WhatsAppLog[]
  messageTemplates  MessageTemplate[]
  messageJobs       MessageJob[]
  auditLogs         AuditLog[]

  paymentCustomers    PaymentCustomer[]
  paymentTransactions PaymentTransaction[]
  subscriptionEvents  SubscriptionEvent[]

  membershipPlans      MembershipPlan[]
  customerMemberships  CustomerMembership[]
  loyaltyAccounts      CustomerLoyaltyAccount[]
  loyaltyTransactions  LoyaltyTransaction[]
  packages             Package[]
  packageServices      PackageService[]
  customerPackages     CustomerPackage[]
  packageUsages        PackageUsage[]

  // Inventory
  productCategories    ProductCategory[]
  products             Product[]
  suppliers            Supplier[]
  purchases            InventoryPurchase[]
  purchaseItems        InventoryPurchaseItem[]
  stockMovements       StockMovement[]
  serviceUsages        ServiceProductUsage[]
  
  // Expenses
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  recurringExpenses    RecurringExpense[]
  
  campaigns            WhatsAppCampaign[]
  campaignRecipients   WhatsAppCampaignRecipient[]

  feedbackRequests     FeedbackRequest[]
  feedback             CustomerFeedback[]
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  displayName         String?
  invoicePrefix       String  @default("INV-")
  defaultTax          Decimal @default(0) @db.Decimal(5, 2)
  currency            String  @default("INR")
  timezone            String  @default("Asia/Kolkata")
  appointmentSettings Json?
  birthdayDiscount    Json?
  whatsappSettings    Json?
  loyaltySettings     Json?
  feedbackSettings    Json?
  invoiceFooter       String?
  receiptLogo         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// Platform Administration
// ------------------------------------------------------

enum PlatformAdminRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
}

enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

model PlatformAdmin {
  id           String              @id @default(uuid())
  name         String
  email        String              @unique
  mobile       String?
  passwordHash String
  role         PlatformAdminRole   @default(PLATFORM_ADMIN)
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  failedLogins Int                 @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model AdminInvitation {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  role      PlatformAdminRole @default(PLATFORM_ADMIN)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id                  String   @id @default("global") // Single row pattern
  
  // General
  platformName        String   @default("Arikone Salon & Spa Manager")
  platformDescription String?
  supportEmail        String?
  supportPhone        String?
  supportWebsite      String?
  defaultCountry      String   @default("India")
  defaultCurrency     String   @default("INR")
  defaultTimezone     String   @default("Asia/Kolkata")
  
  // Branding
  logoUrl             String?
  faviconUrl          String?
  loginBackgroundUrl  String?
  primaryColor        String?

  // Mail
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPasswordHash    String?
  smtpFromName        String?
  smtpFromEmail       String?
  smtpSecure          Boolean  @default(true)
  
  // WhatsApp
  whatsappProvider    String?
  whatsappEnabled     Boolean  @default(true)
  
  // Security
  sessionTimeoutMins  Int      @default(1440)
  maxLoginAttempts    Int      @default(5)
  lockoutDurationMins Int      @default(30)
  
  // Subscriptions
  defaultTrialDays    Int      @default(14)
  gracePeriodDays     Int      @default(3)
  
  // Maintenance
  maintenanceEnabled  Boolean  @default(false)
  maintenanceMessage  String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum PlatformNotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
}

model PlatformNotification {
  id        String                       @id @default(uuid())
  type      String
  title     String
  message   String
  severity  PlatformNotificationSeverity @default(INFO)
  isRead    Boolean                      @default(false)
  
  createdAt DateTime                     @default(now())
  
  @@index([isRead])
  @@index([severity])
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  billingInterval BillingInterval @default(MONTHLY)
  isActive        Boolean         @default(true)
  features        Json            // e.g. { CRM: true, WHATSAPP: false }
  limits          Json            // e.g. { USERS: 3, CUSTOMERS: 500 }
  
  tenants         Tenant[]
  subscriptions   TenantSubscription[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model TenantSubscription {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  
  status         SubscriptionStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  trialStartDate DateTime?
  trialEndDate   DateTime?
  cancelledAt    DateTime?
  
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions   PaymentTransaction[]
  events         SubscriptionEvent[]

  @@index([tenantId])
  @@index([status])
}

model OwnerInvitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ------------------------------------------------------
// Subscription Billing & Payments
// ------------------------------------------------------

model PaymentCustomer {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           String
  providerCustomerId String
  email              String?
  name               String?
  mobile             String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([provider, providerCustomerId])
  @@index([tenantId])
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model PaymentTransaction {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider              String
  providerTransactionId String             @unique
  providerOrderId       String?
  amount                Decimal            @db.Decimal(12, 2)
  currency              String             @default("INR")
  status                PaymentStatus      @default(PENDING)
  paymentMethod         String?
  paidAt                DateTime?
  failureReason         String?
  metadata              Json?

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

enum SubscriptionEventType {
  CREATED
  TRIAL_STARTED
  ACTIVATED
  RENEWED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAST_DUE
  GRACE_PERIOD_STARTED
  SUSPENDED
  CANCELLED
  EXPIRED
  PLAN_CHANGED
}

model SubscriptionEvent {
  id              String                @id @default(uuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    TenantSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType       SubscriptionEventType
  source          String                @default("SYSTEM")
  providerEventId String?
  metadata        Json?

  createdAt       DateTime              @default(now())

  @@index([tenantId])
  @@index([subscriptionId])
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id           String        @id @default(uuid())
  provider     String
  eventId      String
  eventType    String
  payloadHash  String
  processedAt  DateTime?
  status       WebhookStatus @default(PENDING)
  errorMessage String?

  createdAt    DateTime      @default(now())

  @@unique([provider, eventId])
  @@index([status])
}

// ------------------------------------------------------
// Authentication & Users
// ------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
  STAFF
}

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  email        String
  mobile       String?
  passwordHash String
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffProfile Staff?

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ------------------------------------------------------
// Business Entities
// ------------------------------------------------------

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name            String
  mobile          String?
  email           String?
  designation     String?
  joiningDate     DateTime?
  status          StaffStatus @default(ACTIVE)
  commissionType  String?
  commissionValue Decimal?    @db.Decimal(10, 2)
  notes           String?

  appointments Appointment[]
  feedbackRequests FeedbackRequest[]
  feedback CustomerFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  mobile         String
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  notes          String?
  whatsappOptOut Boolean   @default(false)
  isActive       Boolean   @default(true)

  appointments Appointment[]
  invoices     Invoice[]
  whatsAppLogs WhatsAppLog[]

  memberships          CustomerMembership[]
  loyaltyAccount       CustomerLoyaltyAccount?
  loyaltyTransactions  LoyaltyTransaction[]
  packages             CustomerPackage[]
  campaignRecipients   WhatsAppCampaignRecipient[]

  feedbackRequests     FeedbackRequest[]
  feedback             CustomerFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, mobile])
  @@index([tenantId, name])
  @@index([tenantId])
}

model ServiceCategory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Service {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name            String
  description     String?
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int
  taxPercent      Decimal @default(0) @db.Decimal(5, 2)
  isActive        Boolean @default(true)

  appointments  Appointment[]
  invoiceItems  InvoiceItem[]
  offerServices OfferService[]
  packageServices PackageService[]
  packageUsages   PackageUsage[]
  productUsages   ServiceProductUsage[]

  feedbackRequests FeedbackRequest[]
  feedback CustomerFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum AppointmentStatus {
  NEW
  CONFIRMED
  ARRIVED
  SERVICE_STARTED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  appointmentDate    DateTime
  startTime          DateTime
  endTime            DateTime?
  status             AppointmentStatus @default(NEW)
  notes              String?
  cancellationReason String?
  completedAt        DateTime?

  invoice Invoice?
  
  feedbackRequests FeedbackRequest[]
  feedback CustomerFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@index([tenantId, serviceId])
}

// ------------------------------------------------------
// Billing & Payments
// ------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum InvoicePaymentStatus {
  PAID
  PARTIAL
  PENDING
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  // Snapshots
  customerNameSnapshot    String?
  customerMobileSnapshot  String?
  businessNameSnapshot    String?
  businessAddressSnapshot String?

  appliedOfferId         String?
  appliedOfferName       String?
  appliedCouponCode      String?
  appliedDiscountPercent Decimal? @db.Decimal(5, 2)
  appliedDiscountAmount  Decimal? @db.Decimal(10, 2)

  purchasedMembershipPlanId String?
  purchasedPackageId        String?
  redeemedLoyaltyPoints     Int?

  finalizedAt DateTime?
  cancelledAt DateTime?
  cancelledBy String?

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  paymentStatus InvoicePaymentStatus @default(PENDING)
  paymentMode   PaymentMode?
  notes         String?
  issuedAt      DateTime             @default(now())

  invoiceItems InvoiceItem[]
  payments     Payment[]

  feedbackRequests FeedbackRequest[]
  feedback CustomerFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  serviceName String // For legacy reasons, acts as item name now
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  appliedCustomerPackageId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount          Decimal     @db.Decimal(10, 2)
  paymentMode     PaymentMode
  referenceNumber String?
  paidAt          DateTime    @default(now())
  notes           String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([invoiceId])
}

// ------------------------------------------------------
// Marketing & Offers
// ------------------------------------------------------

model Offer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(10, 2)
  minimumBill     Decimal? @db.Decimal(10, 2)
  maximumDiscount Decimal? @db.Decimal(10, 2)
  couponCode      String?

  applicableServices OfferApplicableServices @default(ALL)

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  usageLimit Int?
  usageCount Int  @default(0)

  createdBy String?
  updatedBy String?

  offerServices OfferService[]
  campaigns     WhatsAppCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, couponCode])
  @@index([tenantId])
}

enum OfferApplicableServices {
  ALL
  SPECIFIC
}

model OfferService {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, serviceId])
  @@index([tenantId])
}

// ------------------------------------------------------
// Communication
// ------------------------------------------------------

enum WhatsAppMessageType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  INVOICE
  THANK_YOU
  BIRTHDAY_GREETING
  FEEDBACK_REQUEST
  OTHER
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model WhatsAppLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  messageType       WhatsAppMessageType
  recipientMobile   String
  providerMessageId String?
  status            WhatsAppMessageStatus @default(QUEUED)

  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  errorMessage String?

  campaignRecipient WhatsAppCampaignRecipient?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
}

model MessageTemplate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  type     WhatsAppMessageType
  content  String              @db.Text
  isActive Boolean             @default(true)
  
  campaigns WhatsAppCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum MessageJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model MessageJob {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type           WhatsAppMessageType
  recipient      String
  payload        Json
  status         MessageJobStatus    @default(PENDING)
  attempts       Int                 @default(0)
  scheduledAt    DateTime
  sentAt         DateTime?
  lastAttemptAt  DateTime?
  errorMessage   String?
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, scheduledAt])
}

// ------------------------------------------------------
// Audit Logs
// ------------------------------------------------------

model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String?
  action      String
  entityType  String
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

// ------------------------------------------------------
// Memberships
// ------------------------------------------------------

enum DurationUnit {
  MONTH
  YEAR
}

model MembershipPlan {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name               String
  description        String?
  price              Decimal      @db.Decimal(10, 2)
  durationValue      Int
  durationUnit       DurationUnit
  discountPercentage Decimal?     @db.Decimal(5, 2)
  isActive           Boolean      @default(true)
  
  createdBy          String?
  updatedBy          String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  customerMemberships CustomerMembership[]

  @@index([tenantId])
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

model CustomerMembership {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  membershipPlanId   String
  membershipPlan     MembershipPlan   @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)

  startDate          DateTime
  endDate            DateTime
  status             MembershipStatus @default(ACTIVE)
  purchaseInvoiceId  String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([membershipPlanId])
}

// ------------------------------------------------------
// Loyalty Points
// ------------------------------------------------------

model CustomerLoyaltyAccount {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId       String   @unique
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  pointsBalance    Int      @default(0)
  lifetimeEarned   Int      @default(0)
  lifetimeRedeemed Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, customerId])
  @@index([tenantId])
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRY
  REVERSAL
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type             LoyaltyTransactionType
  points           Int
  balanceAfter     Int
  invoiceId        String?
  description      String?

  createdBy        String?
  createdAt        DateTime               @default(now())

  @@index([tenantId])
  @@index([customerId])
}

// ------------------------------------------------------
// Packages
// ------------------------------------------------------

model Package {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  validityDays     Int
  isActive         Boolean  @default(true)

  createdBy        String?
  updatedBy        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  packageServices  PackageService[]
  customerPackages CustomerPackage[]

  @@index([tenantId])
}

model PackageService {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  packageId        String
  package          Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  quantity         Int

  createdAt        DateTime @default(now())

  @@unique([packageId, serviceId])
  @@index([tenantId])
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  CANCELLED
}

model CustomerPackage {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  packageId         String
  package           Package         @relation(fields: [packageId], references: [id], onDelete: Restrict)

  purchaseInvoiceId String?
  purchasedAt       DateTime
  expiresAt         DateTime
  status            PackageStatus   @default(ACTIVE)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  usages            PackageUsage[]

  @@index([tenantId])
  @@index([customerId])
  @@index([packageId])
}

model PackageUsage {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerPackageId  String
  customerPackage    CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)

  serviceId          String
  service            Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  appointmentId      String?
  invoiceId          String?

  quantityUsed       Int

  createdBy          String?
  usedAt             DateTime        @default(now())
  createdAt          DateTime        @default(now())

  @@index([tenantId])
  @@index([customerPackageId])
}

// ------------------------------------------------------
// Inventory Management
// ------------------------------------------------------

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean  @default(true)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum ProductUnit {
  PIECE
  BOTTLE
  BOX
  PACK
  ML
  LITRE
  GRAM
  KG
  OTHER
}

model Product {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name              String
  sku               String?
  barcode           String?
  description       String?
  
  unit              ProductUnit
  costPrice         Decimal         @default(0) @db.Decimal(10, 2)
  sellingPrice      Decimal         @default(0) @db.Decimal(10, 2)
  taxPercentage     Decimal         @default(0) @db.Decimal(5, 2)
  
  openingStock      Decimal         @default(0) @db.Decimal(10, 2)
  currentStock      Decimal         @default(0) @db.Decimal(10, 2)
  minimumStockLevel Decimal         @default(0) @db.Decimal(10, 2)
  reorderLevel      Decimal         @default(0) @db.Decimal(10, 2)
  
  isActive          Boolean         @default(true)
  trackInventory    Boolean         @default(true)

  createdBy         String?
  updatedBy         String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  purchaseItems     InventoryPurchaseItem[]
  stockMovements    StockMovement[]
  serviceUsages     ServiceProductUsage[]
  invoiceItems      InvoiceItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
}

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  mobile      String?
  email       String?
  address     String?
  gstin       String?
  notes       String?
  isActive    Boolean  @default(true)

  purchases   InventoryPurchase[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model InventoryPurchase {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId      String
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseNumber  String
  purchaseDate    DateTime
  
  subtotal        Decimal           @default(0) @db.Decimal(10, 2)
  tax             Decimal           @default(0) @db.Decimal(10, 2)
  discount        Decimal           @default(0) @db.Decimal(10, 2)
  total           Decimal           @default(0) @db.Decimal(10, 2)
  
  paymentStatus   InvoicePaymentStatus @default(PENDING) // Reusing existing payment status
  notes           String?
  status          PurchaseStatus    @default(DRAFT)

  createdBy       String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items           InventoryPurchaseItem[]
  stockMovements  StockMovement[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId])
  @@index([supplierId])
}

model InventoryPurchaseItem {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseId  String
  purchase    InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity    Decimal           @db.Decimal(10, 2)
  unitCost    Decimal           @db.Decimal(10, 2)
  tax         Decimal           @default(0) @db.Decimal(10, 2)
  total       Decimal           @db.Decimal(10, 2)

  @@index([tenantId])
  @@index([purchaseId])
  @@index([productId])
}

enum StockMovementType {
  PURCHASE
  SALE
  SERVICE_USAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  DAMAGE
  EXPIRED
  REVERSAL
}

model StockMovement {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  type           StockMovementType
  quantity       Decimal           @db.Decimal(10, 2)
  stockBefore    Decimal           @db.Decimal(10, 2)
  stockAfter     Decimal           @db.Decimal(10, 2)

  referenceType  String?
  referenceId    String?           // For soft relation without strictly enforcing FK

  // If the reference is a Purchase, we can provide an optional explicit relation
  purchaseId     String?
  purchase       InventoryPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  reason         String?
  createdBy      String?

  createdAt      DateTime          @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([createdAt])
}

model ServiceProductUsage {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity    Decimal  @db.Decimal(10, 2)
  unit        ProductUnit

  @@unique([serviceId, productId])
  @@index([tenantId])
}

// ------------------------------------------------------
// Expense Management
// ------------------------------------------------------

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum RecurringExpenseFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean  @default(true)

  expenses    Expense[]
  recurringExpenses RecurringExpense[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Expense {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  expenseNumber      String

  categoryId         String
  category           ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title              String
  description        String?
  amount             Decimal          @db.Decimal(10, 2)
  expenseDate        DateTime
  paymentMode        PaymentMode?
  vendorName         String?
  referenceNumber    String?
  
  status             ExpenseStatus    @default(DRAFT)
  
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  
  attachmentUrl      String?

  createdBy          String?
  approvedBy         String?
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tenantId, expenseNumber])
  @@index([tenantId])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([status])
  @@index([paymentMode])
}

model RecurringExpense {
  id               String                    @id @default(uuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId       String
  category         ExpenseCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title            String
  description      String?
  amount           Decimal                   @db.Decimal(10, 2)
  frequency        RecurringExpenseFrequency
  
  startDate        DateTime
  endDate          DateTime?
  nextDueDate      DateTime
  
  paymentMode      PaymentMode?
  vendorName       String?
  
  status           Boolean                   @default(true) // isActive

  createdBy        String?
  updatedBy        String?

  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  expenses         Expense[]

  @@index([tenantId])
  @@index([nextDueDate])
  @@index([status])
}

// ------------------------------------------------------
// WhatsApp Campaigns
// ------------------------------------------------------

enum WhatsAppCampaignType {
  PROMOTIONAL
  REENGAGEMENT
  SERVICE_PROMOTION
  MEMBERSHIP_PROMOTION
  PACKAGE_PROMOTION
  FESTIVAL
  CUSTOM
}

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum WhatsAppCampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
  OPTED_OUT
}

model WhatsAppCampaign {
  id                 String                 @id @default(uuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name               String
  description        String?
  campaignType       WhatsAppCampaignType   @default(CUSTOM)
  
  templateId         String?
  template           MessageTemplate?       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  
  offerId            String?
  offer              Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)

  status             WhatsAppCampaignStatus @default(DRAFT)
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  
  audienceDefinition Json?
  
  totalRecipients    Int                    @default(0)
  queuedCount        Int                    @default(0)
  sentCount          Int                    @default(0)
  deliveredCount     Int                    @default(0)
  failedCount        Int                    @default(0)

  createdBy          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  recipients         WhatsAppCampaignRecipient[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model WhatsAppCampaignRecipient {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  campaignId    String
  campaign      WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  phoneNumber   String
  status        WhatsAppCampaignRecipientStatus @default(PENDING)
  
  queuedAt      DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  
  messageLogId  String?  @unique
  messageLog    WhatsAppLog? @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, campaignId, customerId])
  @@index([tenantId])
  @@index([campaignId])
}

// ------------------------------------------------------
// Customer Feedback
// ------------------------------------------------------

enum FeedbackRequestStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  OPENED
  RESPONDED
  EXPIRED
  CANCELLED
  FAILED
}

model FeedbackRequest {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  staffId       String?
  staff         Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  status        FeedbackRequestStatus @default(PENDING)
  tokenHash     String   @unique
  
  expiresAt     DateTime
  sentAt        DateTime?
  respondedAt   DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feedback      CustomerFeedback?

  @@index([tenantId])
  @@index([tokenHash])
  @@index([tenantId, status])
  @@unique([tenantId, appointmentId])
}

model CustomerFeedback {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestId     String   @unique
  request       FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  staffId       String?
  staff         Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  rating        Int
  comment       String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([staffId])
  @@index([serviceId])
  @@index([rating])
}

